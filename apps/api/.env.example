PORT=3001
CORS_ORIGIN=http://localhost:3000

# Shared HMAC secret for the Auth.js ↔ Hono JWT bridge (T3.5).
# MUST be byte-for-byte identical to the web app's NEXTAUTH_SECRET.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Neon Postgres — copy connection string from Neon dashboard
DATABASE_URL=

# Google Places API (New) — server-only key
GOOGLE_PLACES_API_KEY=
