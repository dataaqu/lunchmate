# App
NEXTAUTH_URL=http://localhost:3000

# Canonical public origin — used for SEO metadata, Open Graph URLs, sitemap and
# JSON-LD (see src/lib/site.ts). On Vercel this falls back to the deployment URL
# automatically; set it explicitly for the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared HMAC secret for Auth.js JWTs — must match the Hono API (T3.5).
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth 2.0 client (GCP Console → APIs & Services → Credentials).
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email magic-link sign-in (optional; activates once the Drizzle adapter
# lands in T3.2). EMAIL_SERVER is an SMTP connection string.
# e.g. smtp://user:pass@smtp.example.com:587
EMAIL_SERVER=
EMAIL_FROM=

# API base URL (server-side calls)
API_URL=http://localhost:3001

# Google Maps JavaScript API (client-side — safe to expose, restrict by HTTP referrer in GCP)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# API base URL (client-side browser calls)
NEXT_PUBLIC_API_URL=http://localhost:3001
